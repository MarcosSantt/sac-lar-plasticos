# Produção: copie para .env (na raiz do projeto) e ajuste os valores.

# Senha do banco de dados. Use apenas letras e números (ela entra em uma URL de conexão).
DB_PASSWORD=

# Administrador criado na primeira inicialização. A senha é provisória:
# o portal exige a troca no primeiro acesso.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Porta em que o portal fica disponível no servidor.
APP_PORT=8080

# Com HTTPS na frente do portal (recomendado), defina os dois como true.
COOKIE_SECURE=false
TRUST_PROXY=false

# Horas de inatividade até a sessão expirar e tamanho máximo de cada anexo.
SESSION_TTL_HOURS=12
MAX_FILE_MB=10
